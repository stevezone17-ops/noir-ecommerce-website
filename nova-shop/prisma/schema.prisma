generator client {
  provider = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Customer {
  role Role @default(CUSTOMER)
  id String @id @default(cuid())
  email String @unique
  name String
  passwordHash String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sessions Session[]
  orders Order[]
}
model Session {
  digest String @id
  customerId String
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  @@index([customerId])
  @@index([expiresAt])
}
model AuthAttempt {
  key String @id
  count Int
  expiresAt DateTime
  @@index([expiresAt])
}
enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}
model Order {
  tracking String?
  inventoryHold Boolean @default(false)
  paidAt DateTime?
  id String @id @default(cuid())
  customerId String
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  status OrderStatus @default(PENDING_PAYMENT)
  currency String @default("INR")
  subtotalPaise Int
  shippingPaise Int @default(0)
  totalPaise Int
  shippingEmail String?
  checkoutKey String?
  @@unique([customerId, checkoutKey])
  shippingName String
  shippingPhone String
  addressLine1 String
  addressLine2 String?
  city String
  state String
  postalCode String
  country String @default("IN")
  razorpayOrderId String? @unique
  razorpayPaymentId String? @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  items OrderItem[]
  paymentEvents PaymentEvent[]
  @@index([customerId, createdAt])
}
model OrderItem {
  variant Variant? @relation(fields:[variantId],references:[id],onDelete:NoAction,onUpdate:NoAction)
  variantId Int?
  allocated Boolean @default(false)
  category String?
  costPaise Int?
  supplier Supplier? @relation(fields:[supplierId],references:[id],onDelete:NoAction,onUpdate:NoAction)
  supplierId Int?
  supplierStatus String @default("Awaiting")
  supplierTracking String?
  id String @id @default(cuid())
  orderId String
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  title String
  quantity Int
  unitPricePaise Int
  lineTotalPaise Int
}
model PaymentEvent {
  id String @id @default(cuid())
  providerEventId String @unique
  orderId String?
  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)
  eventType String
  createdAt DateTime @default(now())
}

enum Role {
  CUSTOMER
  ADMIN
}
model Product {
  id Int @id @default(autoincrement())
  name String
  category String
  description String @default("")
  tag String @default("")
  pricePaise Int
  image String @default("")
  photo Bytes?
  active Boolean @default(true)
  supplierId Int?
  supplier Supplier? @relation(fields:[supplierId], references:[id], onDelete:NoAction,onUpdate:NoAction)
  costPaise Int?
  variants Variant[]
}
model Variant {
  orderItems OrderItem[]
  id Int @id @default(autoincrement())
  productId Int
  product Product @relation(fields:[productId],references:[id],onDelete:NoAction,onUpdate:NoAction)
  size String
  color String
  stock Int @default(0)
  @@unique([productId,size,color])
}
model Supplier {
  orderItems OrderItem[]
  id Int @id @default(autoincrement())
  name String
  contact String
  email String
  phone String
  deliveryDays Int
  products Product[]
}
model Audit {
  id Int @id @default(autoincrement())
  actor String
  action String
  target String
  detail String
  createdAt DateTime @default(now())
  @@index([target,id])
}
